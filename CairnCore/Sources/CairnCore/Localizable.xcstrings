    "Anthropic is rate limiting requests or is overloaded right now. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic limite les requêtes ou est surchargé pour le moment. Réessaie dans un instant."
          }
        }
      }
    },
    "Anthropic rejects the API key. Check it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic refuse la clé API. Vérifie-la dans les Réglages."
          }
        }
      }
    },
    "Anthropic reports a billing problem on this API account (out of credit?).": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic signale un problème de facturation sur ce compte API (crédit épuisé ?)."
          }
        }
      }
    },
    "Apple Intelligence is turned off. Turn it on in Settings or choose Ollama.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans les Réglages ou choisis Ollama."
          }
        }
      }
    },
    "Apple's model is not available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'Apple n'est pas disponible sur cet appareil."
          }
        }
      }
    },
    "Apple's model is not ready yet (download in progress?). Try again later.": {
      "extractionState": "manual",
      "localizations": {
