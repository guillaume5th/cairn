    },
    "Claude Code is not signed in to any account. Run “claude” in a terminal to sign in.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n'est connecté à aucun compte. Lance « claude » dans un terminal pour te connecter."
          }
        }
      }
    },
    "Claude refused to summarize this content.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
